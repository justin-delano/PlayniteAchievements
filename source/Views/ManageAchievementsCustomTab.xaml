<UserControl x:Class="PlayniteAchievements.Views.ManageAchievementsCustomTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="980"
             d:DataContext="{d:DesignInstance vm:ManageAchievementsCustomViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/ManageAchievementsScopedControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility" />
            <converters:BooleanConverter x:Key="InverseBoolToVis" Mode="InvertedToVisibility" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>

            <Style x:Key="GridEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InlineBrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="0.72" />
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Opacity" Value="0.82" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="#FFE07070" />
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PreviewBorderStyle" TargetType="Border">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="VariantBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="#12000000" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Custom}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="12,0,0,0">
                    <Button x:Name="AddButton"
                            Content="{DynamicResource LOCPlayAch_Common_Add}"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="DuplicateButton"
                            Content="{DynamicResource LOCPlayAch_Common_Duplicate}"
                            Command="{Binding DuplicateCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="DeleteButton"
                            Content="{DynamicResource LOCPlayAch_Common_Delete}"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="PasteImportButton"
                            Content="{DynamicResource LOCPlayAch_ManageAchievements_Custom_PasteImport}"
                            Command="{Binding PasteImportCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="ImportFileButton"
                            Content="{DynamicResource LOCPlayAch_Common_Import}"
                            Command="{Binding ImportFileCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="ExportButton"
                            Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}"
                            Click="ExportButton_Click"
                            Style="{StaticResource ToolbarButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ExportAchievements}"
                                          Command="{Binding ExportAchievementsCommand}" />
                                <MenuItem Header="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ExportTemplate}"
                                          Command="{Binding ExportTemplateCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RevertButton"
                            Content="{DynamicResource LOCPlayAch_Common_RevertChanges}"
                            Command="{Binding RevertCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="ClearButton"
                            Content="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ClearAll}"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    <Button x:Name="SaveButton"
                            Content="{DynamicResource LOCPlayAch_Button_Save}"
                            Command="{Binding SaveCommand}"
                            Padding="12,6"
                            Margin="0,0,0,8" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CustomAchievementsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding AchievementRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      Background="Transparent"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ColumnHeaderStyle="{StaticResource ManageAchievementsColumnHeaderStyle}"
                      helpers:DataGridHoverScrollBarBehavior.IsEnabled="True"
                      helpers:DataGridAlignmentBehavior.IsEnabled="True"
                      KeyboardNavigation.DirectionalNavigation="Continue"
                      Tag="ControllerCellFocus">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ManageAchievementsControllerCellStyle}" />
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ManageAchievementsDataGridRowStyle}">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="ClipToBounds" Value="True" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_Unlocked}"
                                            Width="78"
                                            SortMemberPath="Unlocked"
                                            CellStyle="{StaticResource ManageAchievementsCheckBoxCellStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Unlocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          IsTabStop="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="42"
                                            MinWidth="42"
                                            MaxWidth="42"
                                            CanUserResize="False"
                                            CellStyle="{StaticResource ManageAchievementsIconCellStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="26"
                                       Height="26"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       helpers:AsyncImage.Uri="{Binding DisplayIcon}"
                                       helpers:AsyncImage.DecodePixel="64" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_AchievementName}"
                                            Width="190"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridEditorTextBoxStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Description}"
                                            Width="240"
                                            SortMemberPath="Description">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridEditorTextBoxStyle}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ID"
                                            Width="150"
                                            SortMemberPath="Id">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridEditorTextBoxStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Rarity}"
                                            Width="140"
                                            SortMemberPath="Rarity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- One editor for both rarity inputs: type an unlock percent, or pick a tier. -->
                                <ComboBox IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          TextSearch.TextPath="DisplayName"
                                          ItemsSource="{Binding DataContext.RarityOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Text="{Binding RarityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MinHeight="26"
                                          VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="16"
                                                       Height="16"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value}" Value="UltraRare">
                                                                    <Setter Property="Source" Value="{DynamicResource BadgeRarityUltraRare}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value}" Value="Rare">
                                                                    <Setter Property="Source" Value="{DynamicResource BadgeRarityRare}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value}" Value="Uncommon">
                                                                    <Setter Property="Source" Value="{DynamicResource BadgeRarityUncommon}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Value}" Value="Common">
                                                                    <Setter Property="Source" Value="{DynamicResource BadgeRarityCommon}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Column_Points}"
                                            Width="90"
                                            SortMemberPath="PointsText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PointsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GridEditorTextBoxStyle}"
                                         HorizontalContentAlignment="Center"
                                         Tag="NonNegativeInt"
                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                         DataObject.Pasting="NumericTextBox_Pasting" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{DynamicResource LOCPlayAch_Common_UnlockTime}"
                                            Width="300"
                                            SortMemberPath="UnlockTime">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center"
                                      Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding HasUnlockTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding Unlocked}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              IsTabStop="False" />

                                    <Grid Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center">
                                        <TextBlock Text="-"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding CanEditUnlockTime, Converter={StaticResource InverseBoolToVis}}" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding CanEditUnlockTime, Converter={StaticResource BoolToVis}}">
                                            <DatePicker SelectedDate="{Binding UnlockDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Padding="4,2"
                                                        Margin="0,0,6,0" />
                                            <TextBox Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="62"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Center"
                                                     Padding="4,0"
                                                     MaxLength="5">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValidTime}" Value="False">
                                                                <Setter Property="BorderBrush" Value="#FFE07070" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox ItemsSource="{Binding AvailableTimeModes}"
                                                      SelectedItem="{Binding SelectedTimeModeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="74"
                                                      VerticalContentAlignment="Center"
                                                      Padding="4,0"
                                                      Margin="2,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_Details}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_NoSelection}"
                                   Foreground="{DynamicResource TextBrush}"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVis}}" />

                        <StackPanel DataContext="{Binding SelectedRow}"
                                    Visibility="{Binding DataContext.HasSelectedRow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <CheckBox Content="{DynamicResource LOCPlayAch_ManageAchievements_Custom_Hidden}"
                                      IsChecked="{Binding Hidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,12,0,0" />

                            <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_TrophyType}"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.TrophyTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding TrophyType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="26"
                                      VerticalContentAlignment="Center" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ProgressNum}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ProgressNumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GridEditorTextBoxStyle}"
                                             Tag="NonNegativeInt"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             DataObject.Pasting="NumericTextBox_Pasting" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Custom_ProgressDenom}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ProgressDenomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource GridEditorTextBoxStyle}"
                                             Tag="PositiveInt"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             DataObject.Pasting="NumericTextBox_Pasting" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="#FFE07070"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Border Margin="0,14,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding SelectedRow}">
                                <TextBlock Text="{DynamicResource LOCPlayAch_ManageAchievements_Tab_CustomIcons}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource VariantBadgeStyle}"
                                            ToolTip="{DynamicResource LOCPlayAch_Common_Unlocked}">
                                        <TextBlock Text="&#x2713;"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource GlyphBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource PreviewBorderStyle}"
                                            Margin="8,0,0,0">
                                        <Image Width="32"
                                               Height="32"
                                               Stretch="Uniform"
                                               helpers:AsyncImage.Uri="{Binding UnlockedPreviewPath}"
                                               helpers:AsyncImage.DecodePixel="72" />
                                    </Border>

                                    <Grid Grid.Column="2"
                                          Margin="8,0,0,0">
                                        <TextBox Text="{Binding UnlockedIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource GridEditorTextBoxStyle}"
                                                 Tag="Unlocked"
                                                 ToolTip="{Binding UnlockedIconPath}"
                                                 AllowDrop="True"
                                                 PreviewDragOver="IconTextBox_PreviewDragOver"
                                                 Drop="IconTextBox_Drop" />
                                        <Button Tag="{Binding UnlockedIconPath}"
                                                CommandParameter="Unlocked"
                                                Style="{StaticResource ClearSearchButtonStyle}"
                                                Focusable="True"
                                                Click="ClearIconButton_Click" />
                                    </Grid>

                                    <Button Grid.Column="3"
                                            Content="..."
                                            Tag="Unlocked"
                                            ToolTip="{DynamicResource LOCPlayAch_Button_Browse}"
                                            Style="{StaticResource InlineBrowseButtonStyle}"
                                            Click="BrowseIconButton_Click" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource VariantBadgeStyle}"
                                            ToolTip="{DynamicResource LOCPlayAch_Common_Locked}">
                                        <Image Source="{StaticResource BadgeLocked}"
                                               Width="13"
                                               Height="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.72" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource PreviewBorderStyle}"
                                            Margin="8,0,0,0">
                                        <Image Width="32"
                                               Height="32"
                                               Stretch="Uniform"
                                               helpers:AsyncImage.Uri="{Binding LockedPreviewPath}"
                                               helpers:AsyncImage.DecodePixel="72" />
                                    </Border>

                                    <Grid Grid.Column="2"
                                          Margin="8,0,0,0">
                                        <TextBox Text="{Binding LockedIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource GridEditorTextBoxStyle}"
                                                 Tag="Locked"
                                                 ToolTip="{Binding LockedIconPath}"
                                                 AllowDrop="True"
                                                 PreviewDragOver="IconTextBox_PreviewDragOver"
                                                 Drop="IconTextBox_Drop" />
                                        <Button Tag="{Binding LockedIconPath}"
                                                CommandParameter="Locked"
                                                Style="{StaticResource ClearSearchButtonStyle}"
                                                Focusable="True"
                                                Click="ClearIconButton_Click" />
                                    </Grid>

                                    <Button Grid.Column="3"
                                            Content="..."
                                            Tag="Locked"
                                            ToolTip="{DynamicResource LOCPlayAch_Button_Browse}"
                                            Style="{StaticResource InlineBrowseButtonStyle}"
                                            Click="BrowseIconButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
