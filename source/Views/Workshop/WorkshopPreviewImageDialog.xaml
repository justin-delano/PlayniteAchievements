<UserControl x:Class="PlayniteAchievements.Views.Workshop.WorkshopPreviewImageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="760">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="NameText"
                       Grid.Row="0"
                       Style="{DynamicResource PlayAch.TextBlock.BaseStyle}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>

            <!-- The image to submit, at most 900x600 and never upscaled. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PlayAch.Brush.Surface}"
                    BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                    BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                    CornerRadius="4"
                    Padding="8">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       MaxWidth="900"
                       MaxHeight="600"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <Grid Grid.Row="2" Margin="{StaticResource PlayAch.Thickness.Top.Md}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{DynamicResource LOCPlayAch_Button_Browse}"
                        Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                        MinWidth="90"
                        Click="BrowseButton_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SubmitButton"
                            Content="{DynamicResource LOCPlayAch_Workshop_Share_Submit}"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="90"
                            Margin="{StaticResource PlayAch.Thickness.Right.Sm}"
                            Click="SubmitButton_Click"
                            IsDefault="True"/>
                    <Button Content="{DynamicResource LOCPlayAch_Button_Cancel}"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="90"
                            Click="CancelButton_Click"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
