<UserControl x:Class="PlayniteAchievements.Views.Workshop.Preview.SoundsPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:preview="clr-namespace:PlayniteAchievements.Views.Workshop.Preview"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- One row per sound the pack carries: the tier it plays for, the file, and a Test button. -->
    <ItemsControl x:Name="SlotList" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type preview:SoundPreviewRow}">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tier"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding TierLabel}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MinWidth="120"
                               Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FileName}"
                               ToolTip="{Binding FileName}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="{StaticResource PlayAch.Opacity.Muted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="{DynamicResource LOCPlayAch_Button_Test}"
                            Padding="{StaticResource PlayAch.Thickness.ButtonPadding}"
                            MinWidth="72"
                            Margin="12,0,0,0"
                            Tag="{Binding FilePath}"
                            Click="TestButton_Click"
                            Visibility="{Binding ShowTestButton, RelativeSource={RelativeSource AncestorType=preview:SoundsPreviewControl}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
