<UserControl x:Class="PlayniteAchievements.Views.Workshop.Preview.GameDataPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:preview="clr-namespace:PlayniteAchievements.Views.Workshop.Preview"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="820">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The status cell of the published image and of a package's own entries: the
                 capstone badge only, never anyone's unlocked or locked state. -->
            <DataTemplate x:Key="NeutralStatusTemplate">
                <Image Source="{DynamicResource BadgeRarityCompleted}"
                       Width="18"
                       Height="18"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsCapstone, Converter={StaticResource BoolToVis}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary of what the package carries. -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="0"
                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>

        <!-- Package only, or the game it is compared against, and the kept-edits note. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="PackageOnlyText"
                       Text="{DynamicResource LOCPlayAch_Workshop_Preview_PackageOnly}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="GameText"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed">
                <Run Text="{DynamicResource LOCPlayAch_Column_Game}"/><Run Text=": "/><Run x:Name="GameNameRun"/>
            </TextBlock>
            <TextBlock x:Name="KeptEditsText"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Which side of the install, or its category tree, and which rows. -->
        <StackPanel x:Name="ComparisonOptions"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
            <!-- The time-window preset chips' style, as a two-state toggle. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <RadioButton x:Name="BeforeButton"
                             Style="{StaticResource PlayAch.TimeRangeChip.Style}"
                             Content="{DynamicResource LOCPlayAch_Workshop_Preview_Before}"
                             Checked="Options_Changed"/>
                <RadioButton x:Name="AfterButton"
                             Style="{StaticResource PlayAch.TimeRangeChip.Style}"
                             Content="{DynamicResource LOCPlayAch_Workshop_Preview_After}"
                             IsChecked="True"
                             Checked="Options_Changed"/>
                <RadioButton x:Name="CategoriesButton"
                             Style="{StaticResource PlayAch.TimeRangeChip.Style}"
                             Content="{DynamicResource LOCPlayAch_ManageAchievements_Tab_Category}"
                             Checked="Options_Changed"/>
            </StackPanel>
            <CheckBox x:Name="ShowUnchangedCheckBox"
                      VerticalAlignment="Center"
                      Content="{DynamicResource LOCPlayAch_Workshop_Preview_ShowUnchanged}"
                      Checked="Options_Changed"
                      Unchecked="Options_Changed"/>
        </StackPanel>

        <!-- The game's achievements in the grid View Achievements shows them in, one grid after
             the install and one as they are now, Before / After showing one of them; without a
             game, the package's own entries in the after grid. -->
        <controls:AchievementDataGridControl x:Name="AfterGrid"
                                             Grid.Row="3"
                                             ShowControlBar="False"
                                             AllowDisplaySettingsMenu="False"
                                             DataGridMaxHeight="{x:Static preview:GameDataPreviewControl.UnboundedHeight}"
                                             Visibility="Collapsed"/>
        <controls:AchievementDataGridControl x:Name="BeforeGrid"
                                             Grid.Row="3"
                                             ShowControlBar="False"
                                             AllowDisplaySettingsMenu="False"
                                             DataGridMaxHeight="{x:Static preview:GameDataPreviewControl.UnboundedHeight}"
                                             Visibility="Collapsed"/>

        <!-- The after-install category tree, set up as View Achievements' category list:
             art, leaf names under the tree guide, every node expanded, read-only. Its column
             key and column set are set in code. -->
        <controls:GameSummariesGridControl x:Name="CategoryGrid"
                                           Grid.Row="3"
                                           PreserveImageResolution="True"
                                           ShowMetadataPlatform="False"
                                           ShowMetadataPlaytime="False"
                                           ShowMetadataRegion="False"
                                           DisableRowSelection="True"
                                           Visibility="Collapsed"/>

        <TextBlock x:Name="MoreRowsText"
                   Grid.Row="4"
                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                   Opacity="{StaticResource PlayAch.Opacity.Muted}"
                   Margin="4,6,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
