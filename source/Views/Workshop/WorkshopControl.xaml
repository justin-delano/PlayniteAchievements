<UserControl x:Class="PlayniteAchievements.Views.Workshop.WorkshopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             xmlns:vm="clr-namespace:PlayniteAchievements.ViewModels.Workshop"
             xmlns:workshop="clr-namespace:PlayniteAchievements.Services.Workshop"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One row of the browse and installed lists. -->
            <DataTemplate x:Key="WorkshopItemRowTemplate" DataType="{x:Type vm:WorkshopItemViewModel}">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="72" Height="48"
                            Margin="0,0,10,0"
                            Background="{DynamicResource PlayAch.Brush.Surface}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            CornerRadius="3">
                        <Grid>
                            <Image helpers:AsyncImage.Uri="{Binding ThumbnailPath}"
                                   helpers:AsyncImage.DecodePixel="144"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                Size="24"
                                                Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Author, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding GameName}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ContentsSummary}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsBundle, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    ToolTip="{DynamicResource LOCPlayAch_Workshop_Downloads}">
                            <TextBlock Text="&#xEF08;"
                                       FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Downloads}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_UpdateAvailable}"
                                   Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Tab_Installed}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- The right-hand detail pane. -->
            <DataTemplate x:Key="WorkshopItemDetailTemplate" DataType="{x:Type vm:WorkshopItemViewModel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                Height="140"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}">
                            <controls:GlyphIcon Glyph="{Binding KindGlyph}"
                                                FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                                Size="56"
                                                Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                MaxHeight="260"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Image helpers:AsyncImage.Uri="{Binding CoverPath}"
                                   helpers:AsyncImage.DecodePixel="768"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Border Background="{DynamicResource PlayAch.Brush.Surface}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4"
                                MaxHeight="260"
                                Margin="0,0,0,12"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Image helpers:AsyncImage.Uri="{Binding PreviewPath}"
                                   helpers:AsyncImage.DecodePixel="768"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding KindLabel, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Author}"/><Run Text=": "/><Run Text="{Binding Author, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Version}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Downloads}"/><Run Text=": "/><Run Text="{Binding Downloads, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_License}"/><Run Text=": "/><Run Text="{Binding License, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Updated, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource LOCPlayAch_Column_Game}"/><Run Text=": "/><Run Text="{Binding GameName, Mode=OneWay}"/>
                            <Run Text=" → "/><Run Text="{Binding LocalGameName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Tags}"/><Run Text=": "/><Run Text="{Binding Tags, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <Run Text="{DynamicResource LOCPlayAch_Workshop_Contents}"/><Run Text=": "/><Run Text="{Binding ContentsSummary, Mode=OneWay}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                            <Button Content="{Binding ActionLabel}"
                                    MinWidth="110"
                                    IsEnabled="{Binding CanInstall}"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Common_Preview}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Workshop_Report}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.ReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RequiresNewerPluginText}"
                                   Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding RequiresNewerPlugin, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <TextBox Text="{Binding Readme, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"/>
                    </StackPanel>
                </ScrollViewer>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource PlayAch.Brush.Window.Background}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" x:Name="Tabs" Background="Transparent" BorderThickness="0">
                <!-- Browse -->
                <TabItem Header="{DynamicResource LOCPlayAch_Workshop_Tab_Browse}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="320"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filters -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Width="240"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource LOCPlayAch_Button_Search}"/>
                            <ComboBox Width="180" Margin="8,0,0,0"
                                      ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding SelectedKind}"
                                      DisplayMemberPath="Label"
                                      Visibility="{Binding ShowKindFilter, Converter={StaticResource BoolToVis}}"/>
                            <ComboBox Width="160" Margin="8,0,0,0"
                                      ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort}"
                                      DisplayMemberPath="Label"/>
                            <CheckBox Content="{DynamicResource LOCPlayAch_Workshop_OnlyMyGames}"
                                      IsChecked="{Binding OnlyMyGames}"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowOnlyMyGames, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                    Margin="12,0,0,0"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>

                        <!-- List -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <ListBox ItemsSource="{Binding ItemsView}"
                                     SelectedItem="{Binding SelectedItem}"
                                     ItemTemplate="{StaticResource WorkshopItemRowTemplate}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Empty}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       x:Name="EmptyText"
                                       Visibility="Collapsed"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                       TextWrapping="Wrap"
                                       Margin="12"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <!-- Detail -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Background="{DynamicResource PlayAch.Brush.Panel}"
                                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                CornerRadius="4">
                            <ContentControl Content="{Binding SelectedItem}"
                                            ContentTemplate="{StaticResource WorkshopItemDetailTemplate}"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Installed: the same list-and-detail shape as Browse, with the two short
                     lists (undoable page installs, this install's submissions) as cards under
                     the detail pane. -->
                <TabItem Header="{DynamicResource LOCPlayAch_Workshop_Tab_Installed}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="320"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <ListBox ItemsSource="{Binding InstalledItems}"
                                     SelectedItem="{Binding SelectedItem}"
                                     ItemTemplate="{StaticResource WorkshopItemRowTemplate}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_Empty}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasNoInstalledItems, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource PlayAch.Brush.Panel}"
                                    BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                    BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                    CornerRadius="4">
                                <ContentControl Content="{Binding SelectedItem}"
                                                ContentTemplate="{StaticResource WorkshopItemDetailTemplate}"
                                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,10,0,0" MaxHeight="240">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Margin="0,0,5,0"
                                        Padding="12"
                                        Background="{DynamicResource PlayAch.Brush.Panel}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                        CornerRadius="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="{DynamicResource LOCPlayAch_Workshop_RecentInstalls}"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding UndoEntries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:WorkshopUndoViewModel}">
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1"
                                                                    Content="{DynamicResource LOCPlayAch_Workshop_Revert}"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Padding="12"
                                        Background="{DynamicResource PlayAch.Brush.Panel}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                        CornerRadius="4">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource LOCPlayAch_Workshop_MySubmissions}"
                                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding RefreshSubmissionsCommand}"/>
                                        </Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Submissions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:WorkshopSubmissionViewModel}">
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Foreground="{DynamicResource PlayAch.Brush.Text}" Opacity="{StaticResource PlayAch.Opacity.Muted}">
                                                                    <Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Submitted, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding State}"
                                                                       Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0"/>
                                                            <Button Grid.Column="2"
                                                                    Content="{DynamicResource LOCPlayAch_Workshop_OpenOnGitHub}"
                                                                    Command="{Binding DataContext.OpenSubmissionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Status strip -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="4"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="4"
                                 IsIndeterminate="True"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
