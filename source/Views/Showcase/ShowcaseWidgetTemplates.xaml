<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                    xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                    xmlns:showcase="clr-namespace:PlayniteAchievements.Views.Showcase"
                    xmlns:widgets="clr-namespace:PlayniteAchievements.ViewModels.Showcase.Widgets"
                    xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">

    <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility"/>
    <converters:ResourceKeyToImageSourceConverter x:Key="ShowcaseResourceKeyToImage"/>

    <!-- Mosaics can hold 64 tiles, each carrying artwork, a glow effect, and a ray burst that
         redraws while it is on screen. A plain ItemsControl in a ScrollViewer realizes all of
         them at once; this container virtualizes so only the tiles in view exist, while keeping
         the item chrome invisible (the tiles draw themselves). -->
    <Style x:Key="ShowcaseMosaicItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared value/label tile used by the Statistics widget and the Profile stat strip. -->
    <DataTemplate x:Key="ShowcaseStatTileTemplate">
        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Margin="3"
                Padding="8,6"
                ClipToBounds="True">
            <StackPanel>
                <TextBlock Text="{Binding Value}"
                           Foreground="{DynamicResource PlayAch.Brush.Accent}"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Implicit templates: the widget host sets BodyHost.Content to a per-kind view model and
         WPF resolves the matching template by runtime type. One template per kind. -->

    <!-- Profile: avatar + name/subtitle over the provider identity (manual overrides win),
         with a medal-count row outside compact and a stat strip when expanded. -->
    <DataTemplate DataType="{x:Type widgets:ProfileWidgetViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Grid.RowSpan="2"
                   Stretch="UniformToFill"
                   Opacity="0.2"
                   IsHitTestVisible="False"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}"
                   helpers:AsyncImage.Uri="{Binding BackgroundPath}"
                   helpers:AsyncImage.DecodePixel="320"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="{Binding AvatarCornerRadius}"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                    <Image Width="{Binding AvatarSize}"
                           Height="{Binding AvatarSize}"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           helpers:AsyncImage.Uri="{Binding AvatarPath}"
                           helpers:AsyncImage.DecodePixel="{Binding AvatarDecodePixel}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Medals}"
                                  Margin="0,5,0,0"
                                  Visibility="{Binding ShowMedals, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                    <Image Source="{Binding IconKey, Converter={StaticResource ShowcaseResourceKeyToImage}}"
                                           Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Stats}"
                          Margin="0,6,0,0"
                          ItemTemplate="{StaticResource ShowcaseStatTileTemplate}"
                          Visibility="{Binding ShowStatStrip, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- Scores: reuses ScoreCardControl for the collection and/or prestige card, with a
         cumulative score-over-time line under each card outside compact. -->
    <DataTemplate DataType="{x:Type widgets:ScoresWidgetViewModel}">
        <ItemsControl ItemsSource="{Binding Cards}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}"
                                 Columns="{Binding Columns}"
                                 VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Grid rows (not a StackPanel) so a small cell compresses the chart row
                         instead of clipping the date labels off the bottom. -->
                    <Grid Margin="4"
                          MaxWidth="{Binding DataContext.MaxCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:ScoreCardControl
                            ScoreCard="{Binding Card}"
                            IsFeatured="{Binding DataContext.IsFeatured, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ShowNextLevelText="True"
                            Flat="True"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            showcase:ScoreCardInfoBehavior.Enabled="True"/>
                        <TextBlock Grid.Row="1"
                                   Margin="6,2,6,0"
                                   Text="{Binding HistoryCaption}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                   FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                   Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}"/>
                        <lvc:CartesianChart Grid.Row="2"
                                            MaxHeight="{Binding DataContext.ChartHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            MinHeight="34"
                                            LegendLocation="None"
                                            Hoverable="True"
                                            DisableAnimations="True"
                                            Margin="6,2,6,0"
                                            Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Title="{Binding Card.Label}"
                                                Values="{Binding HistoryValues}"
                                                Stroke="{Binding Card.AccentBrush}"
                                                Fill="{Binding Card.AccentBackgroundBrush}"
                                                StrokeThickness="2"
                                                PointGeometry="{x:Null}"
                                                LineSmoothness="0.3"/>
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding HistoryLabels}" ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator IsEnabled="False"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <!-- Floor at the window minimum, ceiling at the next tier; the
                                     dotted sections mark tier boundaries crossed in the window
                                     plus the upcoming one at the top edge. -->
                                <lvc:Axis ShowLabels="True"
                                          FontSize="10"
                                          Foreground="{DynamicResource PlayAch.Brush.Text}"
                                          LabelFormatter="{Binding YLabelFormatter}"
                                          MinValue="{Binding HistoryMinValue}"
                                          MaxValue="{Binding HistoryAxisMax}"
                                          Sections="{Binding TierSections}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                        <Grid Grid.Row="3"
                              Margin="6,1,6,0"
                              Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HistoryStartText}"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HistoryEndText}"
                                       HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- IconMosaic: centered wrap of reused AchievementCompactItemControl icons. -->
    <DataTemplate DataType="{x:Type widgets:IconMosaicWidgetViewModel}">
        <ListBox ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="6"
                 ItemContainerStyle="{StaticResource ShowcaseMosaicItemStyle}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <wpftk:VirtualizingWrapPanel Orientation="Horizontal"
                                                 VirtualizingPanel.CacheLengthUnit="Item"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <controls:AchievementCompactItemControl
                        IconSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        ShowRarityGlow="{Binding DataContext.ShowRarityGlow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        AnimateRarityGlows="{Binding DataContext.AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        UseLargeRarityGlow="True"
                        Margin="6"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

    <!-- Pie: reuses PieChartWithRadialIcons with an optional legend docked right. -->
    <DataTemplate DataType="{x:Type widgets:PieWidgetViewModel}">
        <DockPanel>
            <ItemsControl DockPanel.Dock="Right"
                          ItemsSource="{Binding LegendRows}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Swatch}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Hint}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CountText}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:PieChartWithRadialIcons
                PieSeries="{Binding Chart.PieSeries}"
                LegendItems="{Binding Chart.LegendItems}"
                HighlightedLabels="{Binding Chart.HighlightedLabels}"
                ExactUnlockedCount="{Binding Chart.ExactUnlockedCount}"
                ExactTotalCount="{Binding Chart.ExactTotalCount}"
                ShowCenterPercentage="{Binding ShowCenterPercentage}"
                MinHeight="70"/>
        </DockPanel>
    </DataTemplate>

    <!-- Timeline: the reused LiveCharts column chart with range buttons, identical at every size. -->
    <DataTemplate DataType="{x:Type widgets:TimelineWidgetViewModel}">
        <Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <Grid Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <lvc:CartesianChart Series="{Binding Timeline.TimelineSeries}"
                                    LegendLocation="None"
                                    Hoverable="True"
                                    DisableAnimations="True">
                    <lvc:CartesianChart.Resources>
                        <Style TargetType="lvc:ColumnSeries">
                            <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Style>
                    </lvc:CartesianChart.Resources>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Timeline.TimelineLabels}"
                                  ShowLabels="True"
                                  LabelsRotation="45"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0"
                                  LabelFormatter="{Binding Timeline.YAxisFormatter}"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Ranges}"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SetRangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Value}"
                                    Margin="2,0"
                                    Padding="6,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Statistics: scrolling grid of value/label tiles. -->
    <DataTemplate DataType="{x:Type widgets:StatisticsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}"
                          ItemTemplate="{StaticResource ShowcaseStatTileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- NativePoints: horizontal bars of top-N points by provider or game. -->
    <DataTemplate DataType="{x:Type widgets:NativePointsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="0,1,0,5"
                                Padding="8,5"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ValueText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SecondaryText}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Grid.Row="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Fraction, Mode=OneWay}"
                                             Height="3"
                                             Margin="0,4,0,0"
                                             VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- PinnedAchievements: an instance-owned achievement grid over the selected collection with pin reordering.
         Display DPs bind through GridOptions, the widget's live grid-options record; when it is
         null (no catalog supplied) each DP keeps its default. -->
    <DataTemplate DataType="{x:Type widgets:PinnedAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                                 PinCollectionId="{Binding PinCollectionId}"
                                                 ControlBar="{Binding ControlBar}"
                                                 ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                                 EnablePinReorder="True"
                                                 ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                                 FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                                 UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                                 ShowRarityGlow="{Binding GridOptions.ShowRarityGlow, FallbackValue=True}"
                                                 ColorNamesByRarity="{Binding GridOptions.ColorNamesByRarity, FallbackValue=False}"
                                                 ColorRarityColumnsByRarity="{Binding GridOptions.ColorRarityColumnsByRarity, FallbackValue=False}"/>
    </DataTemplate>

    <!-- Pinned games: the shared game-summaries grid over pinned (or favorite) games. -->
    <DataTemplate DataType="{x:Type widgets:FavoriteGamesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                          PinCollectionId="{Binding PinCollectionId}"
                                          ControlBar="{Binding ControlBar}"
                                          ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                          EnablePinReorder="{Binding PinReorderEnabled}"
                                          ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                          FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                          UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                          ShowCompletionGlow="{Binding GridOptions.ShowCompletionGlow, FallbackValue=True}"
                                          ShowMetadataPlatform="{Binding GridOptions.ShowMetadataPlatform, FallbackValue=True}"
                                          ShowMetadataPlaytime="{Binding GridOptions.ShowMetadataPlaytime, FallbackValue=True}"
                                          ShowMetadataRegion="{Binding GridOptions.ShowMetadataRegion, FallbackValue=True}"/>
    </DataTemplate>

    <!-- RecentAchievements: the shared achievement grid over the latest unlocks. -->
    <DataTemplate DataType="{x:Type widgets:RecentAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                                 ControlBar="{Binding ControlBar}"
                                                 ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                                 ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                                 FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                                 UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                                 ShowRarityGlow="{Binding GridOptions.ShowRarityGlow, FallbackValue=True}"
                                                 ColorNamesByRarity="{Binding GridOptions.ColorNamesByRarity, FallbackValue=False}"
                                                 ColorRarityColumnsByRarity="{Binding GridOptions.ColorRarityColumnsByRarity, FallbackValue=False}"/>
    </DataTemplate>

    <!-- GameSummaries: the shared game-summaries grid over the whole library. -->
    <DataTemplate DataType="{x:Type widgets:GameSummariesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                          ControlBar="{Binding ControlBar}"
                                          ShowControlBar="{Binding GridOptions.ShowControlBar, FallbackValue=False}"
                                          ShowColumnHeaders="{Binding GridOptions.ShowColumnHeaders, FallbackValue=True}"
                                          FixedRowHeight="{Binding GridOptions.RowHeight, FallbackValue={x:Null}}"
                                          UseCoverImages="{Binding GridOptions.UseCoverImages, FallbackValue=False}"
                                          ShowCompletionGlow="{Binding GridOptions.ShowCompletionGlow, FallbackValue=True}"
                                          ShowMetadataPlatform="{Binding GridOptions.ShowMetadataPlatform, FallbackValue=True}"
                                          ShowMetadataPlaytime="{Binding GridOptions.ShowMetadataPlaytime, FallbackValue=True}"
                                          ShowMetadataRegion="{Binding GridOptions.ShowMetadataRegion, FallbackValue=True}"/>
    </DataTemplate>

    <!-- GameMosaic: dense wrap of game cover tiles; pinned-source tiles get a reorder/unpin menu. -->
    <DataTemplate DataType="{x:Type widgets:GameMosaicWidgetViewModel}">
        <ListBox ItemsSource="{Binding Tiles}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource ShowcaseMosaicItemStyle}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <wpftk:VirtualizingWrapPanel Orientation="Horizontal"
                                                 VirtualizingPanel.CacheLengthUnit="Item"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DataTemplate.Resources>
                            <!-- Shared by the visible art and the glow-layer copies so the bloom
                                 tracks the exact same artwork, size, and stretch. -->
                            <Style x:Key="MosaicTileArtStyle" TargetType="Image">
                                <Setter Property="Width" Value="{Binding CoverWidth}"/>
                                <Setter Property="Height" Value="{Binding CoverHeight}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="helpers:AsyncImage.DecodePixel" Value="{Binding DecodePixel}"/>
                                <Setter Property="helpers:AsyncImage.Uri" Value="{Binding CoverPath}"/>
                                <Setter Property="Stretch" Value="UniformToFill"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCover}" Value="False">
                                        <Setter Property="Stretch" Value="Uniform"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataTemplate.Resources>
                        <!-- Margin 6 (not the icon mosaic's 3): the completion bloom renders
                             beyond the art and needs gutter room to read, like the grid's 8,6
                             art margins. -->
                        <Grid Margin="6"
                              ToolTip="{Binding GameName}"
                              ContextMenuService.IsEnabled="{Binding IsPinnable}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveEarlier}"
                                              Command="{Binding MoveEarlierCommand}"/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveLater}"
                                              Command="{Binding MoveLaterCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_RemoveFromCollection}"
                                              Command="{Binding UnpinCommand}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- Backing completion-glow layer, matching the game summaries grid:
                                 two art copies carrying the completed-gradient start/end glows,
                                 cached as one bitmap, outside the clipping border so the bloom
                                 follows the art's silhouette and is never cut off. -->
                            <Border CacheMode="BitmapCache"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding ShowCompletionGlow, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Image Style="{StaticResource MosaicTileArtStyle}"
                                           Effect="{DynamicResource PlayAch.Effect.CompletedGlowStart}"/>
                                    <Image Style="{StaticResource MosaicTileArtStyle}"
                                           Effect="{DynamicResource PlayAch.Effect.CompletedGlowEnd}"/>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                    CornerRadius="{StaticResource PlayAch.Radius.Small}"
                                    ClipToBounds="True">
                                <Image Style="{StaticResource MosaicTileArtStyle}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

    <!-- ActivityCalendar: contributions-style heatmap of unlocks per day. -->
    <!-- Legend swatches only; the calendar grid itself is drawn by ActivityCalendarHeatmap,
         which owns the matching intensity ramp. -->
    <DataTemplate x:Key="ShowcaseActivityCellTemplate" DataType="{x:Type widgets:ActivityCalendarDayViewModel}">
        <Border Width="10" Height="10" CornerRadius="2" Margin="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Intensity}" Value="0">
                            <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="1">
                            <Setter Property="Opacity" Value="0.30"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="2">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Intensity}" Value="3">
                            <Setter Property="Opacity" Value="0.78"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:ActivityCalendarWidgetViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.RowSpan="2"
                       Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <!-- The calendar sizes itself from the plugin's title font size (see
                 ActivityCalendarMetrics) instead of stretching to fill the widget; long
                 ranges overflow into a horizontal scrollbar pinned to the latest weeks,
                 with the mouse wheel mapped to horizontal scrolling. The weekday gutter
                 and the legend sit outside the scroll area so they stay put while the
                 calendar scrolls, and the gutter shares the heatmap's metrics so its
                 rows line up. -->
            <Grid TextElement.FontSize="{DynamicResource PlayAch.FontSize.Title}"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <showcase:ActivityCalendarDayGutter Labels="{Binding WeekdayLabels}"
                                                    ShowMonthBand="True"
                                                    VerticalAlignment="Top"/>
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              showcase:ActivityCalendarScrollBehavior.Enabled="True">
                    <!-- Single custom-drawn visual: one element for the whole grid of cells,
                         with tooltips served from hit tests. -->
                    <showcase:ActivityCalendarHeatmap Weeks="{Binding Weeks}"
                                                      ShowMonthLabels="True"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"/>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_Less}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding LegendCells}"
                              ItemTemplate="{StaticResource ShowcaseActivityCellTemplate}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_More}"
                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
