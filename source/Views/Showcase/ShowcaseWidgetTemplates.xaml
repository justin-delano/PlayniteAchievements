<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
                    xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
                    xmlns:showcase="clr-namespace:PlayniteAchievements.Views.Showcase"
                    xmlns:widgets="clr-namespace:PlayniteAchievements.ViewModels.Showcase.Widgets">

    <converters:BooleanConverter x:Key="BoolToVis" Mode="ToVisibility"/>
    <converters:ResourceKeyToImageSourceConverter x:Key="ShowcaseResourceKeyToImage"/>

    <!-- Implicit templates: the widget host sets BodyHost.Content to a per-kind view model and
         WPF resolves the matching template by runtime type. One template per kind. -->

    <!-- Profile: avatar + name/subtitle over the provider identity (manual overrides win),
         with a medal-count row outside compact and a stat strip when expanded. -->
    <DataTemplate DataType="{x:Type widgets:ProfileWidgetViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Grid.RowSpan="2"
                   Stretch="UniformToFill"
                   Opacity="0.2"
                   IsHitTestVisible="False"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}"
                   helpers:AsyncImage.Uri="{Binding BackgroundPath}"
                   helpers:AsyncImage.DecodePixel="320"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                        BorderBrush="{DynamicResource PlayAch.Brush.Accent}"
                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                        CornerRadius="{Binding AvatarCornerRadius}"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                    <Image Width="{Binding AvatarSize}"
                           Height="{Binding AvatarSize}"
                           Stretch="UniformToFill"
                           SnapsToDevicePixels="True"
                           helpers:AsyncImage.Uri="{Binding AvatarPath}"
                           helpers:AsyncImage.DecodePixel="{Binding AvatarDecodePixel}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowSubtitle, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Medals}"
                                  Margin="0,5,0,0"
                                  Visibility="{Binding ShowMedals, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                    <Image Source="{Binding IconKey, Converter={StaticResource ShowcaseResourceKeyToImage}}"
                                           Width="16"
                                           Height="16"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Stats}"
                          Margin="0,6,0,0"
                          Visibility="{Binding ShowStatStrip, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="3"
                                Padding="8,6"
                                ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}"
                                           Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- Scores: reuses ScoreCardControl for the collection and/or prestige card, with a
         cumulative score-over-time line under each card outside compact. -->
    <DataTemplate DataType="{x:Type widgets:ScoresWidgetViewModel}">
        <ItemsControl ItemsSource="{Binding Cards}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}"
                                 Columns="{Binding Columns}"
                                 VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4"
                                MaxWidth="{Binding DataContext.MaxCardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                VerticalAlignment="Center">
                        <controls:ScoreCardControl
                            ScoreCard="{Binding Card}"
                            IsFeatured="{Binding DataContext.IsFeatured, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ShowNextLevelText="True"
                            Flat="True"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            showcase:ScoreCardInfoBehavior.Enabled="True"/>
                        <StackPanel Margin="6,2,6,0"
                                    Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HistoryCaption}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                            <lvc:CartesianChart Height="{Binding DataContext.ChartHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                LegendLocation="None"
                                                Hoverable="True"
                                                DisableAnimations="True"
                                                Margin="0,2,0,0">
                                <lvc:CartesianChart.Series>
                                    <lvc:LineSeries Title="{Binding Card.Label}"
                                                    Values="{Binding HistoryValues}"
                                                    Stroke="{Binding Card.AccentBrush}"
                                                    Fill="{Binding Card.AccentBackgroundBrush}"
                                                    StrokeThickness="2"
                                                    PointGeometry="{x:Null}"
                                                    LineSmoothness="0.3"/>
                                </lvc:CartesianChart.Series>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding HistoryLabels}" ShowLabels="False">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator IsEnabled="False"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis ShowLabels="False">
                                        <lvc:Axis.Separator>
                                            <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                                        </lvc:Axis.Separator>
                                    </lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Text="{Binding HistoryStartText}"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                                <TextBlock Text="{Binding HistoryEndText}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- IconMosaic: centered wrap of reused AchievementCompactItemControl icons. -->
    <DataTemplate DataType="{x:Type widgets:IconMosaicWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AchievementCompactItemControl
                            IconSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ShowRarityGlow="{Binding DataContext.ShowRarityGlow, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            AnimateRarityGlows="{Binding DataContext.AnimateRarityGlows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            UseLargeRarityGlow="True"
                            Margin="6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- Pie: reuses PieChartWithRadialIcons with an optional legend docked right. -->
    <DataTemplate DataType="{x:Type widgets:PieWidgetViewModel}">
        <DockPanel>
            <ItemsControl DockPanel.Dock="Right"
                          ItemsSource="{Binding LegendRows}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Background="{Binding Swatch}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       Opacity="{StaticResource PlayAch.Opacity.Hint}"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CountText}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:PieChartWithRadialIcons
                PieSeries="{Binding Chart.PieSeries}"
                LegendItems="{Binding Chart.LegendItems}"
                HighlightedLabels="{Binding Chart.HighlightedLabels}"
                ExactUnlockedCount="{Binding Chart.ExactUnlockedCount}"
                ExactTotalCount="{Binding Chart.ExactTotalCount}"
                ShowCenterPercentage="True"
                MinHeight="70"/>
        </DockPanel>
    </DataTemplate>

    <!-- Timeline: compact bar sparkline, or the reused LiveCharts column chart with range buttons. -->
    <DataTemplate DataType="{x:Type widgets:TimelineWidgetViewModel}">
        <Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding SparklineBars}"
                          VerticalAlignment="Stretch"
                          Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="1,0">
                            <Border Height="{Binding BarHeight}"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1"
                                    ToolTip="{Binding Tooltip}"
                                    Background="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <lvc:CartesianChart Series="{Binding Timeline.TimelineSeries}"
                                    LegendLocation="None"
                                    Hoverable="True"
                                    DisableAnimations="True">
                    <lvc:CartesianChart.Resources>
                        <Style TargetType="lvc:ColumnSeries">
                            <Setter Property="Fill" Value="{DynamicResource PlayAch.Brush.Accent}"/>
                        </Style>
                    </lvc:CartesianChart.Resources>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Timeline.TimelineLabels}"
                                  ShowLabels="True"
                                  LabelsRotation="45"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0"
                                  LabelFormatter="{Binding Timeline.YAxisFormatter}"
                                  FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                  Foreground="{DynamicResource PlayAch.Brush.Text}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="{DynamicResource PlayAch.Brush.Border}" Opacity="0.2"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Ranges}"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0"
                              Visibility="{Binding ShowRangeButtons, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.SetRangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Value}"
                                    Margin="2,0"
                                    Padding="6,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Statistics: density-capped grid of value/label tiles. -->
    <DataTemplate DataType="{x:Type widgets:StatisticsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="3"
                                Padding="8,6"
                                ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}"
                                           Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- NativePoints: horizontal bars of top-N points by provider or game. -->
    <DataTemplate DataType="{x:Type widgets:NativePointsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="0,1,0,5"
                                Padding="8,5"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ValueText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SecondaryText}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Grid.Row="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Fraction}"
                                             Height="3"
                                             Margin="0,4,0,0"
                                             VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- PinnedAchievements: the shared achievement grid over pinned rows with pin reordering. -->
    <DataTemplate DataType="{x:Type widgets:PinnedAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="ShowcasePinnedAchievements"
                                                 EnablePinReorder="True"
                                                 ShowColumnHeaders="{Binding ShowColumnHeaders}"
                                                 FixedRowHeight="{Binding RowHeight}"/>
    </DataTemplate>

    <!-- Pinned games: the shared game-summaries grid over pinned (or favorite) games. -->
    <DataTemplate DataType="{x:Type widgets:FavoriteGamesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="ShowcasePinnedGames"
                                          EnablePinReorder="{Binding PinReorderEnabled}"
                                          ShowColumnHeaders="{Binding ShowColumnHeaders}"
                                          FixedRowHeight="{Binding RowHeight}"/>
    </DataTemplate>

    <!-- RecentAchievements: the shared achievement grid over the latest unlocks. -->
    <DataTemplate DataType="{x:Type widgets:RecentAchievementsWidgetViewModel}">
        <showcase:ShowcaseAchievementGridControl ItemsSource="{Binding Items}"
                                                 ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                                 ShowColumnHeaders="{Binding ShowColumnHeaders}"
                                                 FixedRowHeight="{Binding RowHeight}"/>
    </DataTemplate>

    <!-- GameSummaries: the shared game-summaries grid over the whole library. -->
    <DataTemplate DataType="{x:Type widgets:GameSummariesWidgetViewModel}">
        <showcase:ShowcaseGameGridControl ItemsSource="{Binding Items}"
                                          ColumnSettingsKey="{Binding ColumnSettingsKey}"
                                          ShowColumnHeaders="{Binding ShowColumnHeaders}"
                                          FixedRowHeight="{Binding RowHeight}"/>
    </DataTemplate>

    <!-- GameMosaic: dense wrap of game cover tiles; pinned-source tiles get a reorder/unpin menu. -->
    <DataTemplate DataType="{x:Type widgets:GameMosaicWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Small}"
                                Margin="3"
                                ClipToBounds="True"
                                ToolTip="{Binding GameName}"
                                ContextMenuService.IsEnabled="{Binding IsPinnable}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveEarlier}"
                                              Command="{Binding MoveEarlierCommand}"/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveLater}"
                                              Command="{Binding MoveLaterCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_UnpinGame}"
                                              Command="{Binding UnpinCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Image Width="{Binding CoverWidth}"
                                   Height="{Binding CoverHeight}"
                                   SnapsToDevicePixels="True"
                                   helpers:AsyncImage.Uri="{Binding CoverPath}"
                                   helpers:AsyncImage.DecodePixel="{Binding DecodePixel}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Stretch" Value="UniformToFill"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- ActivityCalendar: contributions-style heatmap of unlocks per day. -->
    <Style x:Key="ShowcaseActivityCellStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Accent}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Intensity}" Value="-1">
                <Setter Property="Background" Value="Transparent"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Intensity}" Value="0">
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Intensity}" Value="1">
                <Setter Property="Opacity" Value="0.30"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Intensity}" Value="2">
                <Setter Property="Opacity" Value="0.55"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Intensity}" Value="3">
                <Setter Property="Opacity" Value="0.78"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ShowcaseActivityCellTemplate" DataType="{x:Type widgets:ActivityCalendarDayViewModel}">
        <Border Width="{Binding Size}"
                Height="{Binding Size}"
                ToolTip="{Binding Tooltip}"
                Style="{StaticResource ShowcaseActivityCellStyle}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type widgets:ActivityCalendarWidgetViewModel}">
        <Grid>
            <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_NoData}"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="{StaticResource PlayAch.Opacity.Placeholder}"
                       FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            <!-- Horizontal-only scrolling: the Viewbox sees a constrained height and infinite
                 width, so it scales the calendar to fill the widget's height and long ranges
                 overflow into a horizontal scrollbar instead of shrinking. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0"
                                    Visibility="{Binding ShowWeekdayLabels, Converter={StaticResource BoolToVis}}">
                            <TextBlock Height="14"
                                       Visibility="{Binding ShowMonthLabels, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding WeekdayLabels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Height="{Binding DataContext.WeekdayRowHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Weeks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Fixed label slot the width of one cell box; longer text
                                             paints past the slot without widening the column. -->
                                        <TextBlock Text="{Binding MonthLabel}"
                                                   Height="14"
                                                   Width="12"
                                                   TextWrapping="NoWrap"
                                                   HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                                   FontSize="9"
                                                   Visibility="{Binding DataContext.ShowMonthLabels, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=Viewbox}}"/>
                                        <ItemsControl ItemsSource="{Binding Days}"
                                                      ItemTemplate="{StaticResource ShowcaseActivityCellTemplate}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_Less}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                   FontSize="9"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding LegendCells}"
                                      ItemTemplate="{StaticResource ShowcaseActivityCellTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_ActivityLegend_More}"
                                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                                   Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                   FontSize="9"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
