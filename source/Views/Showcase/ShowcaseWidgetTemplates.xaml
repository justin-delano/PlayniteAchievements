<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
                    xmlns:widgets="clr-namespace:PlayniteAchievements.ViewModels.Showcase.Widgets">

    <!-- Implicit templates: the widget host sets BodyHost.Content to a per-kind view model and
         WPF resolves the matching template by runtime type. One template per kind. -->

    <!-- Statistics: density-capped grid of value/label tiles. -->
    <DataTemplate DataType="{x:Type widgets:StatisticsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="3"
                                Padding="8,6"
                                ClipToBounds="True">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}"
                                           Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource PlayAch.FontSize.SectionHeader}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- NativePoints: horizontal bars of top-N points by provider or game. -->
    <DataTemplate DataType="{x:Type widgets:NativePointsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="0,1,0,5"
                                Padding="8,5"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ValueText}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SecondaryText}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           Opacity="{StaticResource PlayAch.Opacity.Muted}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Grid.Row="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Fraction}"
                                             Height="3"
                                             Margin="0,4,0,0"
                                             VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- PinnedAchievements: icon + name (+ game name) rows with a reorder/unpin menu. -->
    <DataTemplate DataType="{x:Type widgets:PinnedAchievementsWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="0,1,0,5"
                                Padding="7,6"
                                ClipToBounds="True">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveEarlier}"
                                              Command="{Binding MoveEarlierCommand}"/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveLater}"
                                              Command="{Binding MoveLaterCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_UnpinAchievement}"
                                              Command="{Binding UnpinCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                        CornerRadius="7"
                                        Padding="2"
                                        ClipToBounds="True">
                                    <Image Width="38"
                                           Height="38"
                                           Stretch="UniformToFill"
                                           SnapsToDevicePixels="True"
                                           Opacity="{Binding IconOpacity}"
                                           helpers:AsyncImage.Uri="{Binding IconPath}"
                                           helpers:AsyncImage.DecodePixel="76"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding GameName}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               Opacity="{StaticResource PlayAch.Opacity.Subtle}"
                                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowGameName}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

    <!-- FavoriteGames: centered wrap of cover tiles; showcase-pin tiles get a reorder/unpin menu. -->
    <DataTemplate DataType="{x:Type widgets:FavoriteGamesWidgetViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                                Margin="3"
                                Padding="5"
                                ClipToBounds="True"
                                ContextMenuService.IsEnabled="{Binding IsPinnable}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveEarlier}"
                                              Command="{Binding MoveEarlierCommand}"/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_MoveLater}"
                                              Command="{Binding MoveLaterCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource LOCPlayAch_Showcase_UnpinGame}"
                                              Command="{Binding UnpinCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <StackPanel Width="{Binding TileWidth}">
                                <Border Background="{DynamicResource PlayAch.Brush.Overlay.Tint.08}"
                                        BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                        BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                                        CornerRadius="7"
                                        Padding="2"
                                        ClipToBounds="True">
                                    <Image Width="{Binding CoverWidth}"
                                           Height="{Binding CoverHeight}"
                                           SnapsToDevicePixels="True"
                                           helpers:AsyncImage.Uri="{Binding CoverPath}"
                                           helpers:AsyncImage.DecodePixel="{Binding DecodePixel}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="UniformToFill"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                        <Setter Property="Stretch" Value="Uniform"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                                <TextBlock Text="{Binding GameName}"
                                           Foreground="{DynamicResource PlayAch.Brush.Text}"
                                           FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowName}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
