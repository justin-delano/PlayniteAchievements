<UserControl x:Class="PlayniteAchievements.Views.Showcase.ShowcaseWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnSizeChanged">
    <Border x:Name="RootBorder"
            Background="{DynamicResource PlayAch.Brush.Surface}"
            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
            CornerRadius="{StaticResource PlayAch.Radius.Section}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource PlayAch.Brush.Overlay.Tint.08}"
                    Padding="12,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="24"
                            Height="24"
                            CornerRadius="{StaticResource PlayAch.Radius.Small}"
                            Background="{StaticResource PlayAch.Brush.Overlay.Tint.14}"
                            Margin="0,0,9,0">
                        <TextBlock x:Name="GlyphText"
                                   FontFamily="{DynamicResource PlayAch.FontFamily.Icon}"
                                   Foreground="{DynamicResource PlayAch.Brush.Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontWeight="SemiBold"
                               FontSize="{DynamicResource PlayAch.FontSize.Body}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <ContentControl x:Name="BodyHost"
                            Grid.Row="1"
                            Margin="12"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
