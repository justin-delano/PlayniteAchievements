<UserControl x:Class="PlayniteAchievements.Views.Showcase.ShowcaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Detached by OverviewControl and re-hosted in the window header's top-right
             slot so the dashboard gets the full height of the tab content area. -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PreviousPageButton"
                    Grid.Column="0"
                    Content="{DynamicResource LOCPlayAch_Showcase_PreviousPageLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_PreviousPage}"
                    Click="PreviousPageButton_Click"
                    MinWidth="72"/>
            <ComboBox x:Name="PageSelector"
                      Grid.Column="1"
                      DisplayMemberPath="Name"
                      SelectionChanged="PageSelector_SelectionChanged"
                      MinWidth="150"
                      MaxWidth="320"
                      Margin="6,0"/>
            <Button x:Name="NextPageButton"
                    Grid.Column="2"
                    Content="{DynamicResource LOCPlayAch_Showcase_NextPageLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_NextPage}"
                    Click="NextPageButton_Click"
                    MinWidth="72"/>
            <TextBlock x:Name="PageCountText"
                       Grid.Column="3"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <!-- Shows the mode a click switches to: Edit while viewing, View while editing.
                 The label is swapped in EditLayoutButton_Changed; MinWidth keeps the header
                 from shifting between the two labels. -->
            <ToggleButton x:Name="EditLayoutButton"
                          Grid.Column="5"
                          Content="{DynamicResource LOCPlayAch_Common_Edit}"
                          Checked="EditLayoutButton_Changed"
                          Unchecked="EditLayoutButton_Changed"
                          MinWidth="56"
                          Margin="18,0,6,0"/>
            <Button x:Name="PageActionsButton"
                    Grid.Column="6"
                    Content="{DynamicResource LOCPlayAch_Showcase_PageActionsLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_PageActions}"
                    Click="PageActionsButton_Click"
                    MinWidth="72"/>
        </Grid>

        <Grid x:Name="DashboardSurface"
              Grid.Row="2">
            <Grid x:Name="DashboardGrid"/>
        </Grid>
    </Grid>
</UserControl>
