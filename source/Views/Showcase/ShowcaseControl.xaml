<UserControl x:Class="PlayniteAchievements.Views.Showcase.ShowcaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PreviousPageButton"
                    Grid.Column="0"
                    Content="{DynamicResource LOCPlayAch_Showcase_PreviousPageLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_PreviousPage}"
                    Click="PreviousPageButton_Click"
                    MinWidth="72"/>
            <ComboBox x:Name="PageSelector"
                      Grid.Column="1"
                      DisplayMemberPath="Name"
                      SelectionChanged="PageSelector_SelectionChanged"
                      MinWidth="150"
                      MaxWidth="320"
                      Margin="6,0"/>
            <Button x:Name="NextPageButton"
                    Grid.Column="2"
                    Content="{DynamicResource LOCPlayAch_Showcase_NextPageLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_NextPage}"
                    Click="NextPageButton_Click"
                    MinWidth="72"/>
            <TextBlock x:Name="PageCountText"
                       Grid.Column="3"
                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                       Opacity="0.7"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>

            <ToggleButton x:Name="EditLayoutButton"
                          Grid.Column="5"
                          Content="{DynamicResource LOCPlayAch_Showcase_EditLayout}"
                          Checked="EditLayoutButton_Changed"
                          Unchecked="EditLayoutButton_Changed"
                          Margin="0,0,6,0"/>
            <Button x:Name="PageActionsButton"
                    Grid.Column="6"
                    Content="{DynamicResource LOCPlayAch_Showcase_PageActionsLabel}"
                    ToolTip="{DynamicResource LOCPlayAch_Showcase_PageActions}"
                    Click="PageActionsButton_Click"
                    MinWidth="96"/>
        </Grid>

        <Border x:Name="EditToolsPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource PlayAch.Brush.Overlay.Tint.08}"
                BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                CornerRadius="{StaticResource PlayAch.Radius.Card}"
                Padding="8,6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedBlockText"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{DynamicResource LOCPlayAch_Showcase_LayoutHint}"
                               Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="WidgetActionButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_ChangeWidget}"
                            Click="WidgetActionButton_Click"
                            Margin="4,0"/>
                    <Button x:Name="WidgetSettingsButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_WidgetSettings}"
                            Click="WidgetSettingsButton_Click"
                            Margin="4,0"/>
                    <Button x:Name="DeleteWidgetButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_DeleteWidget}"
                            Click="DeleteWidgetButton_Click"
                            Margin="4,0,10,0"/>
                    <Button x:Name="SplitColumnsButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_SplitColumns}"
                            Click="SplitColumnsButton_Click"
                            Margin="4,0"/>
                    <Button x:Name="SplitRowsButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_SplitRows}"
                            Click="SplitRowsButton_Click"
                            Margin="4,0,10,0"/>
                    <Button x:Name="MergeLeftButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_MergeLeftLabel}"
                            ToolTip="{DynamicResource LOCPlayAch_Showcase_MergeLeft}"
                            Click="MergeLeftButton_Click"
                            MinWidth="72"
                            Margin="2,0"/>
                    <Button x:Name="MergeUpButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_MergeUpLabel}"
                            ToolTip="{DynamicResource LOCPlayAch_Showcase_MergeUp}"
                            Click="MergeUpButton_Click"
                            MinWidth="72"
                            Margin="2,0"/>
                    <Button x:Name="MergeDownButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_MergeDownLabel}"
                            ToolTip="{DynamicResource LOCPlayAch_Showcase_MergeDown}"
                            Click="MergeDownButton_Click"
                            MinWidth="72"
                            Margin="2,0"/>
                    <Button x:Name="MergeRightButton"
                            Content="{DynamicResource LOCPlayAch_Showcase_MergeRightLabel}"
                            ToolTip="{DynamicResource LOCPlayAch_Showcase_MergeRight}"
                            Click="MergeRightButton_Click"
                            MinWidth="72"
                            Margin="2,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="DashboardSurface"
              Grid.Row="2">
            <Grid x:Name="DashboardGrid"/>
        </Grid>
    </Grid>
</UserControl>
