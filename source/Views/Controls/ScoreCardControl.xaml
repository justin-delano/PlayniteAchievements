<UserControl x:Class="PlayniteAchievements.Views.Controls.ScoreCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PlayniteAchievements.Views.Converters"
             x:Name="Root"
             FontFamily="{DynamicResource CommonFont}"
             FontSize="{DynamicResource PlayAch.FontSize.Body}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ScoreInfoButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="Opacity" Value="0.68"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{DynamicResource LOCPlayAch_Score_Info_ButtonTooltip}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="9"
                                    Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.22}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.22}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ScoreCardPanelStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="CornerRadius" Value="10"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="15,13"/>
                        <Setter Property="MinHeight" Value="112"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardBadgeStyle" TargetType="Image" BasedOn="{StaticResource RarityIcon}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Effect" Value="{StaticResource BadgeShadow}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Width" Value="54"/>
                        <Setter Property="Height" Value="62"/>
                        <Setter Property="Margin" Value="0,0,16,0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="Opacity" Value="0.78"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                        <Setter Property="Opacity" Value="0.86"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardPointsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="ExtraBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,1,0,2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="Margin" Value="0,2,0,5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTierTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Caption}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Body}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource GameProgressBar}">
                <Setter Property="Height" Value="5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,1,0,4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFeatured, ElementName=Root}" Value="True">
                        <Setter Property="Height" Value="7"/>
                        <Setter Property="Margin" Value="0,1,0,7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScoreCardTooltipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.PopupSurface}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Width" Value="300"/>
                <Setter Property="MaxWidth" Value="300"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="ScoreCardTooltipLineBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PlayAch.Brush.Overlay.Tint.14}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>

            <Style x:Key="ScoreCardTooltipLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlayAch.TextBlock.BaseStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PlayAch.Brush.Text}"/>
                <Setter Property="FontSize" Value="{DynamicResource PlayAch.FontSize.Title}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding ScoreCard, ElementName=Root}">
        <Border Style="{StaticResource ScoreCardPanelStyle}"
                Background="{Binding AccentBackgroundBrush}"
                BorderBrush="{Binding AccentBrush}">
            <Border.ToolTip>
                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Placement="Bottom"
                         HorizontalOffset="0"
                         VerticalOffset="4"
                         Width="300"
                         Padding="{StaticResource PlayAch.Thickness.None}"
                         BorderThickness="0"
                         Background="{DynamicResource PlayAch.Brush.PopupSurface}"
                         HorizontalContentAlignment="Stretch"
                         HasDropShadow="True">
                    <Border Style="{StaticResource ScoreCardTooltipBorderStyle}"
                            BorderBrush="{Binding AccentBrush}">
                        <StackPanel>
                            <Border Style="{StaticResource ScoreCardTooltipLineBorderStyle}">
                                <TextBlock Text="{Binding CurrentLevelPointsText}"
                                           Style="{StaticResource ScoreCardTooltipLineTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource ScoreCardTooltipLineBorderStyle}">
                                <TextBlock Text="{Binding PointsUntilNextLevelText}"
                                           Style="{StaticResource ScoreCardTooltipLineTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource ScoreCardTooltipLineBorderStyle}">
                                <TextBlock Text="{Binding NextTierThresholdText}"
                                           Style="{StaticResource ScoreCardTooltipLineTextStyle}"
                                           Foreground="{Binding NextTierAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </ToolTip>
            </Border.ToolTip>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="{Binding BadgeIconKey, Converter={StaticResource ResourceKeyToImage}}"
                       Style="{StaticResource ScoreCardBadgeStyle}"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Label}"
                                   Style="{StaticResource ScoreCardLabelTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="&#xE946;"
                                Style="{StaticResource ScoreInfoButtonStyle}"
                                Click="ScoreInfoButton_Click"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding PointsText}"
                               Style="{StaticResource ScoreCardPointsTextStyle}"/>

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding LevelProgress, Mode=OneWay}"
                                 Style="{StaticResource ScoreCardProgressBarStyle}"
                                 BorderBrush="{Binding AccentBrush}"
                                 Foreground="{Binding AccentBrush}"/>

                    <TextBlock Grid.Row="3"
                               Text="{Binding PointsUntilNextLevelText}"
                               FontSize="{DynamicResource PlayAch.FontSize.Caption}"
                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                               Opacity="0.62"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,3"
                               Visibility="{Binding ShowNextLevelText, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

                    <Grid Grid.Row="4" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TierText}"
                                   Style="{StaticResource ScoreCardTierTextStyle}"
                                   Foreground="{Binding AccentBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LevelText}"
                                   Style="{StaticResource ScoreCardTierTextStyle}"
                                   Foreground="{Binding AccentBrush}"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
