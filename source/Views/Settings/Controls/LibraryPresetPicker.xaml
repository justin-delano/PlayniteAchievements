<UserControl x:Class="PlayniteAchievements.Views.Settings.Controls.LibraryPresetPicker"
             x:Name="PickerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- The library items of this kind in one list, the user's own and Workshop ones
             alike, in the card's original row: pick one and Apply it (the target then follows
             it, untracked on screen), Save, Delete, and the card's own buttons. -->
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="PresetSelector"
                      MinWidth="240"
                      SelectionChanged="PresetSelector_SelectionChanged"
                      DropDownOpened="PresetSelector_DropDownOpened">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Detail}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource PlayAch.Brush.Text}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button x:Name="ApplyButton"
                    Content="{DynamicResource LOCPlayAch_Button_Apply}"
                    Margin="8,0,0,0"
                    MinWidth="58"
                    IsEnabled="False"
                    Click="Apply_Click"/>

            <Button Content="{DynamicResource LOCPlayAch_Presets_Save}"
                    Margin="8,0,0,0"
                    Click="Save_Click"/>

            <Button x:Name="DeleteButton"
                    Content="{DynamicResource LOCPlayAch_Button_Delete}"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="Delete_Click"/>

            <!-- The owning card's own buttons (Export and Import menus). -->
            <ContentPresenter Content="{Binding ExtraContent, ElementName=PickerRoot}"
                              VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
