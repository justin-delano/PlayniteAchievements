<UserControl x:Class="PlayniteAchievements.Views.Settings.Workshop.WorkshopPresetsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsScopedControlStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/CommonResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Rows use the plugin's themed ListBox item (hover and selection brushes from the
                 grid tokens), with room to breathe. -->
            <Style x:Key="PresetRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource PlayAch.ListBoxItem.BaseStyle}">
                <Setter Property="Padding" Value="12,7"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PlayAch.Brush.Panel}">
        <!-- Every saved preset across kinds, read from the three preset stores when the page
             opens and after each action. Apply lives on the owning card; this page only lists,
             exports and deletes. -->
        <Border Style="{StaticResource SectionBorderStyle}" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource LOCPlayAch_Presets_Header}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="{StaticResource PlayAch.Thickness.Bottom.Md}"/>
                <Border Grid.Row="1" Style="{StaticResource SectionAccentRuleStyle}"/>
                <TextBlock Grid.Row="2"
                           Text="{DynamicResource LOCPlayAch_Workshop_Presets_Hint}"
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                    <Button x:Name="ExportButton"
                            Content="{DynamicResource LOCPlayAch_ManageAchievements_Overrides_ExportButton}" ContentTemplate="{DynamicResource PlayAch.ButtonContent.Export}"
                            Click="Export_Click"
                            IsEnabled="False"
                            Margin="0,0,8,0"/>
                    <Button x:Name="DeleteButton"
                            Content="{DynamicResource LOCPlayAch_Button_Delete}"
                            Click="Delete_Click"
                            IsEnabled="False"
                            Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource LOCPlayAch_Button_Refresh}"
                            Click="Refresh_Click"/>
                </WrapPanel>
                <Grid Grid.Row="4">
                    <!-- Presets grouped under their kind (Colors, Notifications, Frames, Sounds),
                         one selectable row each; Export and Delete act on the selected row. -->
                    <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}"
                            Background="{DynamicResource PlayAch.Brush.Surface}"
                            CornerRadius="4">
                        <ListBox x:Name="PresetList"
                                 Style="{StaticResource PlayAch.ListBox.BaseStyle}"
                                 ItemContainerStyle="{StaticResource PresetRowStyle}"
                                 SelectionMode="Single"
                                 SelectionChanged="PresetList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="12,10,12,6">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource PlayAch.Brush.Text.Secondary}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource PlayAch.Brush.Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock x:Name="EmptyText"
                               Text="{DynamicResource LOCPlayAch_Workshop_NoPresets}"
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
